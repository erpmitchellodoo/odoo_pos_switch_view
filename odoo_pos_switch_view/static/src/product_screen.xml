<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_pos_switch_view.ProductScreen"
       t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//CategorySelector" position="before">
            <div t-if="!pos.scanning" class="d-flex justify-content-end px-2 py-2">
                <div class="btn-group" role="group" aria-label="Product view">
                    <button type="button" class="btn"
                            t-att-class="productViewState.mode === 'grid' ? 'btn-primary' : 'btn-light'"
                            t-att-aria-pressed="productViewState.mode === 'grid' ? 'true' : 'false'"
                            t-on-click="() => this.setProductViewMode('grid')" title="Grid view">
                        <i class="fa fa-th-large me-1" aria-hidden="true"/> Grid
                    </button>
                    <button type="button" class="btn"
                            t-att-class="productViewState.mode === 'list' ? 'btn-primary' : 'btn-light'"
                            t-att-aria-pressed="productViewState.mode === 'list' ? 'true' : 'false'"
                            t-on-click="() => this.setProductViewMode('list')" title="List view">
                        <i class="fa fa-list me-1" aria-hidden="true"/> List
                    </button>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('product-list')]" position="attributes">
            <attribute name="t-att-class">{'o_pos_switch_list': productViewState.mode === 'list'}</attribute>
        </xpath>
        <xpath expr="//ProductCard" position="attributes">
            <attribute name="class">productViewState.mode === 'list' ? 'flex-row o_pos_switch_row' : 'flex-column'</attribute>
        </xpath>
    </t>
</templates>
